"Ø§Ù„Ø´Ø¹Ø§Ø±Ø§Øª",film_t:"Ø¨ÙƒØ±Ø© Ø§Ù„ÙÙ†",film_p:"Ø³Øª Ø¯Ù‚Ø§Ø¦Ù‚ Ù…Ù† Ø§Ù„Ù„ÙˆØ­Ø§Øª ÙˆÙ‡ÙŠ ØªØªÙƒÙˆÙ‘Ù† â€” Ø´ØºÙ‘Ù„ Ø§Ù„ØµÙˆØª.",logos_t:"Ø§Ù„Ø´Ø¹Ø§Ø±Ø§Øª",logos_p:"Ø«Ù…Ø§Ù†ÙŠØ© Ø´Ø¹Ø§Ø±Ø§ØªØŒ ÙƒÙ„ÙŒÙ‘ Ù…Ù†Ù‡Ø§ Ø¨ØªØ·Ø¨ÙŠÙ‚Ù‡. Ù…Ø±Ù‘Ø± ÙÙˆÙ‚ Ø§Ù„Ø´Ø¹Ø§Ø± Ù„ØªØ±Ù‰ Ø£ÙŠÙ† ÙŠØ¹ÙŠØ´.",guide:"Ø¯Ù„ÙŠÙ„ Ø§Ù„Ù‡ÙˆÙŠØ© ÙƒØ§Ù…Ù„Ø§Ù‹",mo_t:"Ø¹Ø±ÙˆØ¶ Ù…ØªØ­Ø±ÙƒØ©",mo_p:"Ø§Ù„Ø¹Ø±Ø¶ Ø§Ù„ØªÙ‚Ø¯ÙŠÙ…ÙŠ ÙƒÙÙŠÙ„Ù… Ù‚ØµÙŠØ±: Ù†ØµØŒ ØµÙˆØ±Ø©ØŒ ÙˆØ¥ÙŠÙ‚Ø§Ø¹."},
en:{name:"RAGHAD NOUH",line:"The page is drawn the way a life is lived: quietly, and with care.",explore:"Explore",discover:"Discover the work",start:"Start a brief",n_art:"Art",n_gen:"Generative",n_arch:"Works",n_c:"Contact",s1:"Signed art reel",s2:"GANCIO menu film",s3:"Logos with their applications",s4:"Projects in the archive",art_t:"Plates",art_p:"",g1:"A marine restaurant system: hook mark, flock, tide lines, three printed menus, then motion.",skt:"Sketch Architects",sk1:"Identity first, then the account. The post is a frame, not a room gallery.",obj:"The piece first, then the room opens",obj_p:"A chair is chosen like a word. The room is heard after.",f1:"Butterfly chair",f2:"Wing piece",gen_t:"Flow field",gen_p:"Soft noise steers the lines. Same wave decision as the cover, except the rule is mathematical.",arch:"Works",at:"Atelier",at_p:"Raghad Nouh. Umm Al-Qura. Cover ID .",m1:"The page first. If the poster fails, the chair will fail.",m2:"Each piece is a character: height, shadow, silence around it.",m3:"Space is last. We do not start with the room.",c:"Contact",c_p:"For a project, a collaboration, or a question about a piece â€” write here.",sent:"Your message is ready in your mail app â€” press send there.",vr_t:"Virtual Reality Hall",vr_p:"Headsets, a hall, an experience shown the way it was designed.",vr_more:"Watch the full presentation",fn:"Name",fe:"Email",fm:"Message",fs:"Send",rights:"Raghad Nouh",n_logos:"Logos",film_t:"The art reel",film_p:"Six minutes of paintings taking shape â€” turn the sound on.",logos_t:"Logos",logos_p:"Eight marks, each with its application. Hover to see where it lives.",guide:"Full identity guide",mo_t:"Motion decks",mo_p:"The presentation as a short film: text, image, rhythm."}
};
let lang="ar";
function apply(){
  const pack=I18N[lang];
  document.documentElement.lang=lang;
  document.documentElement.dir=lang==="ar"?"rtl":"ltr";
  document.querySelectorAll("[data-i18n]").forEach(el=>{const k=el.getAttribute("data-i18n"); if(pack[k]) el.textContent=pack[k];});
  document.getElementById("langBtn").textContent=lang==="ar"?"EN":"Ø¹";
}
document.getElementById("langBtn").onclick=()=>{lang=lang==="ar"?"en":"ar";apply();};
document.getElementById("form").onsubmit=e=>{
  e.preventDefault();
  const f=e.target;
  const body="Ø§Ù„Ø§Ø³Ù…: "+f.name.value+"\nØ§Ù„Ø¨Ø±ÙŠØ¯: "+f.email.value+"\n\n"+f.msg.value;
  location.href="mailto:?subject="+encodeURIComponent("Ø±Ø³Ø§Ù„Ø© Ù„Ù…ÙˆÙ‚Ø¹ Ø±ØºØ¯ Ù†ÙˆØ­")+"&body="+encodeURIComponent(body);
  document.getElementById("note").hidden=false;
};


document.querySelectorAll("video.auto").forEach(v=>{
  v.muted=true; v.playsInline=true; v.loop=true;
  const io=new IntersectionObserver(es=>{
    es.forEach(e=>{ if(e.isIntersecting){ if(v.preload==="none") v.preload="auto"; v.play().catch(()=>{}); } else v.pause(); });
  },{threshold:.3});
  io.observe(v);
});
(function(){
  const v=document.getElementById("artFilm"); if(!v) return;
  const src=v.dataset.hls;
  if(v.canPlayType("application/vnd.apple.mpegurl")){ v.src=src; return; }
  let loaded=false;
  const load=()=>{ if(loaded) return; loaded=true;
    const sc=document.createElement("script");
    sc.src="https://cdn.jsdelivr.net/npm/hls.js@1.5.17/dist/hls.min.js";
    sc.onload=()=>{ if(window.Hls&&Hls.isSupported()){ const h=new Hls({startLevel:-1,capLevelToPlayerSize:false}); h.loadSource(src); h.attachMedia(v);} };
    document.head.appendChild(sc);
  };
  new IntersectionObserver(es=>{ if(es.some(e=>e.isIntersecting)) load(); },{rootMargin:"600px"}).observe(v);
})();

const bar=document.getElementById("progress");
window.addEventListener("scroll",()=>{
  const h=document.documentElement.scrollHeight-window.innerHeight;
  bar.style.width=(h>0?(window.scrollY/h)*100:0)+"%";
},{passive:true});


const y=document.getElementById("y");
if(y) y.textContent=new Date().getFullYear();
document.querySelector(".nav-toggle")?.addEventListener("click",()=>{
  document.querySelector("nav")?.classList.toggle("open");
});
document.querySelectorAll("nav a").forEach(a=>a.addEventListener("click",()=>document.querySelector("nav").classList.remove("open")));
</script>
